# Site block for the Azul engine. Add it to your Caddyfile and replace the
# domain. Caddy gets and renews the HTTPS certificate itself.
#
# The engine rate-limits per visitor, so it needs the visitor's address.
# Caddy sets X-Client-IP itself, overwriting anything a client sends:
#   - a request from Cloudflare carries the visitor in CF-Connecting-IP;
#   - a request from anywhere else IS the visitor.
# This works whether the DNS record is proxied by Cloudflare or not, and
# nobody can forge the header by connecting to the server directly.
azul.example.com {
	encode gzip

	# https://www.cloudflare.com/ips/
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle @cloudflare {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Client-IP {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Client-IP {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
