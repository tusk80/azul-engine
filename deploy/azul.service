[Unit]
Description=Azul engine and analysis board
After=network-online.target
Wants=network-online.target

[Service]
# Listens on localhost only: the reverse proxy is the public entry point and
# sets X-Client-IP to the visitor's address (see deploy/Caddyfile).
ExecStart=/opt/azul/azul serve -public -addr 127.0.0.1:8080 -ip-header X-Client-IP
Restart=on-failure
RestartSec=2

# Run as a throwaway user with no access to the rest of the machine.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
