/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; img-src 'self' data: blob:; connect-src 'self' https://api.anthropic.com https://generativelanguage.googleapis.com https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/engine.wasm
  Cache-Control: public, max-age=3600
